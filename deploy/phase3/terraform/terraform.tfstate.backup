            "user_data": "#cloud-config\n# First-boot setup of each VM: hostname, an 'ops' user with your SSH key, no password login.\nhostname: rke2-server-1\nmanage_etc_hosts: true\nusers:\n  - name: ops\n    shell: /bin/bash\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGeYDYJYhaJC6m1cvJ9LhvWlffMudZPEikS4XzKecPL7 obaid-khan@obaid-khan-ThinkPad-E14-Gen-7\nssh_pwauth: false\n"
